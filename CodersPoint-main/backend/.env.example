PORT=8080
NODE_ENV=production

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT auth cookies (use a long random string)
ACCESS_TOKEN_SECRET=

# Judge0 code execution
# Option A - self-hosted Judge0 (e.g. on an Oracle Cloud Always Free VM):
JUDGE0_API_URL=http://YOUR_VM_PUBLIC_IP:2358
JUDGE0_AUTH_TOKEN=
# Option B - RapidAPI-hosted Judge0 instead (pay-per-use, leave JUDGE0_AUTH_TOKEN unset):
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# RAPID_API_KEY=
# RAPID_API_HOST=judge0-ce.p.rapidapi.com

# Only needed if frontend is deployed on a different origin than the backend
FRONTEND_URL=http://localhost:5173

LOG_LEVEL=info
